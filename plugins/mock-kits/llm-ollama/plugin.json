{
  "id": "mockarty.llm-ollama",
  "name": "LLM provider: Ollama (local)",
  "version": "1.0.0",
  "description": "A mocked Ollama server: the OpenAI-compatible chat endpoint with streaming and tool calling, plus the native /api/tags and /api/show. Lets CI exercise a local-model path without pulling multi-gigabyte weights.",
  "author": {
    "name": "Mockarty",
    "url": "https://mockarty.ru"
  },
  "homepage": "https://mockarty.ru/docs/plugins-authoring",
  "license": "MIT",
  "min_mockarty_version": "1.0.0",
  "contributes": {
    "mock_kits": [
      {
        "key": "llm_ollama",
        "name": "Ollama (local) API",
        "description": "Chat plus the failures that break integrations. Streaming is automatic when the request sets stream:true. Ask for a failure by sending the model name mock/rate-limit, mock/unauthorized, mock/server-error, mock/context-length, mock/truncated, mock/content-filter, mock/slow.",
        "mocks": [
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 429,
            "description": "Rate limited (429)",
            "tags": [
              "llm",
              "scenario:rate-limit"
            ],
            "priority": 90,
            "conditions": [
              {
                "path": "$.model",
                "assertAction": "equals",
                "value": "mock/rate-limit"
              }
            ],
            "body": {
              "error": {
                "message": "Rate limit reached. Please retry in 2s.",
                "type": "requests",
                "param": null,
                "code": "rate_limit_exceeded"
              }
            },
            "headers": {
              "Content-Type": [
                "application/json"
              ],
              "Retry-After": [
                "2"
              ]
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 401,
            "description": "Invalid API key (401)",
            "tags": [
              "llm",
              "scenario:unauthorized"
            ],
            "priority": 90,
            "conditions": [
              {
                "path": "$.model",
                "assertAction": "equals",
                "value": "mock/unauthorized"
              }
            ],
            "body": {
              "error": {
                "message": "Invalid API key provided.",
                "type": "invalid_request_error",
                "param": null,
                "code": "invalid_api_key"
              }
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 500,
            "description": "Upstream failure (500)",
            "tags": [
              "llm",
              "scenario:server-error"
            ],
            "priority": 90,
            "conditions": [
              {
                "path": "$.model",
                "assertAction": "equals",
                "value": "mock/server-error"
              }
            ],
            "body": {
              "error": {
                "message": "Internal server error.",
                "type": "server_error",
                "param": null,
                "code": null
              }
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 400,
            "description": "Context length exceeded (400)",
            "tags": [
              "llm",
              "scenario:context-length"
            ],
            "priority": 90,
            "conditions": [
              {
                "path": "$.model",
                "assertAction": "equals",
                "value": "mock/context-length"
              }
            ],
            "body": {
              "error": {
                "message": "Input is too long for the requested model. Reduce the length of the messages.",
                "type": "invalid_request_error",
                "param": null,
                "code": "context_length_exceeded"
              }
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 401,
            "description": "Invalid API key (401), by auth header",
            "tags": [
              "llm",
              "scenario:unauthorized"
            ],
            "priority": 80,
            "header_conditions": [
              {
                "path": "$.Authorization",
                "assertAction": "equals",
                "value": "Bearer invalid"
              }
            ],
            "body": {
              "error": {
                "message": "Invalid API key provided.",
                "type": "invalid_request_error",
                "param": null,
                "code": "invalid_api_key"
              }
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 200,
            "description": "Reply cut off at the token limit",
            "tags": [
              "llm",
              "scenario:truncated"
            ],
            "priority": 90,
            "conditions": [
              {
                "path": "$.model",
                "assertAction": "equals",
                "value": "mock/truncated"
              }
            ],
            "llm": {
              "provider": "openai",
              "model": "llama3.2",
              "content": "Here is the beginning of a long answer that stops mid-sen",
              "finishReason": "length",
              "promptTokens": 1200,
              "completionTokens": 16,
              "chunkChars": 8,
              "chunkDelayMs": 20
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 200,
            "description": "Blocked by the content filter",
            "tags": [
              "llm",
              "scenario:content-filter"
            ],
            "priority": 90,
            "conditions": [
              {
                "path": "$.model",
                "assertAction": "equals",
                "value": "mock/content-filter"
              }
            ],
            "llm": {
              "provider": "openai",
              "model": "llama3.2",
              "content": "I can't help with that request.",
              "finishReason": "content_filter",
              "promptTokens": 24,
              "completionTokens": 8
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 200,
            "description": "Slow upstream — 5s before the first byte",
            "tags": [
              "llm",
              "scenario:slow"
            ],
            "priority": 90,
            "delay": 5000,
            "conditions": [
              {
                "path": "$.model",
                "assertAction": "equals",
                "value": "mock/slow"
              }
            ],
            "llm": {
              "provider": "openai",
              "model": "llama3.2",
              "content": "That took a while, but here is the answer.",
              "finishReason": "stop",
              "promptTokens": 18,
              "completionTokens": 10
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 200,
            "description": "Tool calling — the model asks for a function",
            "tags": [
              "llm",
              "scenario:tool-calls"
            ],
            "conditions": [
              {
                "path": "$.tools",
                "assertAction": "notEmpty"
              }
            ],
            "llm": {
              "provider": "openai",
              "model": "llama3.2",
              "content": "",
              "finishReason": "tool_calls",
              "toolCalls": [
                {
                  "name": "get_weather",
                  "arguments": {
                    "location": "Berlin",
                    "unit": "celsius"
                  }
                }
              ],
              "promptTokens": 84,
              "completionTokens": 19
            }
          },
          {
            "route": "/v1/chat/completions",
            "method": "POST",
            "status_code": 200,
            "description": "Chat completion — echoes the last user message",
            "tags": [
              "llm"
            ],
            "llm": {
              "provider": "openai",
              "model": "llama3.2",
              "content": "You said: $.req.lastUserMessage",
              "finishReason": "stop",
              "promptTokens": 12,
              "completionTokens": 24,
              "chunkChars": 6,
              "chunkDelayMs": 25
            }
          },
          {
            "route": "/api/tags",
            "method": "GET",
            "status_code": 200,
            "description": "Installed models (native API)",
            "tags": [
              "llm"
            ],
            "body": {
              "models": [
                {
                  "name": "llama3.2:latest",
                  "model": "llama3.2:latest",
                  "size": 2019393189,
                  "digest": "a80c4f17acd5",
                  "details": {
                    "family": "llama",
                    "parameter_size": "3.2B",
                    "quantization_level": "Q4_K_M"
                  }
                },
                {
                  "name": "qwen2.5-coder:latest",
                  "model": "qwen2.5-coder:latest",
                  "size": 4683087519,
                  "digest": "2b0496514337",
                  "details": {
                    "family": "qwen2",
                    "parameter_size": "7.6B",
                    "quantization_level": "Q4_K_M"
                  }
                }
              ]
            }
          },
          {
            "route": "/api/show",
            "method": "POST",
            "status_code": 200,
            "description": "Model details (native API)",
            "tags": [
              "llm"
            ],
            "body": {
              "details": {
                "family": "llama",
                "parameter_size": "3.2B",
                "quantization_level": "Q4_K_M"
              },
              "model_info": {
                "general.architecture": "llama",
                "llama.context_length": 131072
              }
            }
          },
          {
            "route": "/api/tags",
            "method": "GET",
            "status_code": 500,
            "description": "Ollama not running",
            "tags": [
              "llm",
              "scenario:down"
            ],
            "priority": 90,
            "header_conditions": [
              {
                "path": "$.X-Mock-Scenario",
                "assertAction": "equals",
                "value": "down"
              }
            ],
            "body": {
              "error": "could not connect to ollama app, is it running?"
            }
          }
        ]
      }
    ]
  }
}
