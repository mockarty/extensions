{
  "id": "mockarty.mcp-git",
  "name": "MCP server: Git",
  "version": "1.0.0",
  "description": "A mocked Git MCP server: inspect status and diffs, read the log, create branches and commit — including the errors an agent hits (not a repository, nothing staged, merge conflict). Test a code agent's git flow without touching a working tree.",
  "author": {
    "name": "Mockarty",
    "url": "https://mockarty.ru"
  },
  "homepage": "https://mockarty.ru/docs/plugins-authoring",
  "license": "MIT",
  "min_mockarty_version": "1.0.0",
  "contributes": {
    "mock_kits": [
      {
        "key": "mcp_git",
        "name": "Git MCP server",
        "description": "Local repository tools: status, diff, log, branch, commit. Use repo_path containing \"notarepo\" to exercise the invalid-repository error.",
        "mocks": [
          {
            "protocol": "mcp",
            "description": "Show the working tree status",
            "tags": [
              "mcp"
            ],
            "mcp": {
              "tool": "git_status",
              "description": "Show the working tree status.",
              "input_schema": {
                "type": "object",
                "properties": {
                  "repo_path": {
                    "type": "string",
                    "description": "Absolute path to the repository"
                  }
                },
                "required": [
                  "repo_path"
                ]
              }
            },
            "body": {
              "content": [
                {
                  "type": "text",
                  "text": "On branch main\nChanges not staged for commit:\n  modified:   internal/mockkit/mockkit.go\nUntracked files:\n  examples/plugins/llm-openai/"
                }
              ]
            }
          },
          {
            "protocol": "mcp",
            "description": "not-a-repo",
            "tags": [
              "mcp",
              "scenario:not-a-repo"
            ],
            "priority": 90,
            "mcp_is_error": true,
            "conditions": [
              {
                "path": "$.repo_path",
                "assertAction": "contains",
                "value": "notarepo"
              }
            ],
            "mcp": {
              "tool": "git_status",
              "description": "Show the working tree status."
            },
            "body": {
              "content": [
                {
                  "type": "text",
                  "text": "Error: $.req.repo_path is not a git repository (or any of the parent directories): .git"
                }
              ]
            }
          },
          {
            "protocol": "mcp",
            "description": "Show changes not yet staged",
            "tags": [
              "mcp"
            ],
            "mcp": {
              "tool": "git_diff_unstaged",
              "description": "Show changes not yet staged.",
              "input_schema": {
                "type": "object",
                "properties": {
                  "repo_path": {
                    "type": "string",
                    "description": "Absolute path to the repository"
                  }
                },
                "required": [
                  "repo_path"
                ]
              }
            },
            "body": {
              "content": [
                {
                  "type": "text",
                  "text": "diff --git a/internal/mockkit/mockkit.go b/internal/mockkit/mockkit.go\n@@ -30,6 +30,10 @@\n+// ProtocolMCP marks a kit mock that answers an MCP tool call.\n+const ProtocolMCP = \"mcp\""
                }
              ]
            }
          },
          {
            "protocol": "mcp",
            "description": "Show recent commits",
            "tags": [
              "mcp"
            ],
            "mcp": {
              "tool": "git_log",
              "description": "Show recent commits.",
              "input_schema": {
                "type": "object",
                "properties": {
                  "repo_path": {
                    "type": "string",
                    "description": "Absolute path to the repository"
                  },
                  "max_count": {
                    "type": "number",
                    "description": "How many commits to return"
                  }
                },
                "required": [
                  "repo_path"
                ]
              }
            },
            "body": {
              "content": [
                {
                  "type": "text",
                  "text": "9f2c1a7 feat(api): add pagination to the orders endpoint\n4b81de3 fix(auth): refresh token was not rotated on reuse\n1e07c55 docs: describe the retry policy"
                }
              ]
            }
          },
          {
            "protocol": "mcp",
            "description": "Create a new branch",
            "tags": [
              "mcp"
            ],
            "mcp": {
              "tool": "git_create_branch",
              "description": "Create a new branch.",
              "input_schema": {
                "type": "object",
                "properties": {
                  "repo_path": {
                    "type": "string",
                    "description": "Absolute path to the repository"
                  },
                  "branch_name": {
                    "type": "string",
                    "description": "New branch name"
                  },
                  "base_branch": {
                    "type": "string",
                    "description": "Branch to base it on, defaults to the current one"
                  }
                },
                "required": [
                  "repo_path",
                  "branch_name"
                ]
              }
            },
            "body": {
              "content": [
                {
                  "type": "text",
                  "text": "Created branch '$.req.branch_name' from 'main'"
                }
              ]
            }
          },
          {
            "protocol": "mcp",
            "description": "Commit the staged changes",
            "tags": [
              "mcp"
            ],
            "mcp": {
              "tool": "git_commit",
              "description": "Commit the staged changes.",
              "input_schema": {
                "type": "object",
                "properties": {
                  "repo_path": {
                    "type": "string",
                    "description": "Absolute path to the repository"
                  },
                  "message": {
                    "type": "string",
                    "description": "Commit message"
                  }
                },
                "required": [
                  "repo_path",
                  "message"
                ]
              }
            },
            "body": {
              "content": [
                {
                  "type": "text",
                  "text": "Committed as 7f3a91c2\n[main 7f3a91c2] $.req.message\n 2 files changed, 48 insertions(+)"
                }
              ]
            }
          },
          {
            "protocol": "mcp",
            "description": "empty-message",
            "tags": [
              "mcp",
              "scenario:empty-message"
            ],
            "priority": 90,
            "mcp_is_error": true,
            "conditions": [
              {
                "path": "$.message",
                "assertAction": "equals",
                "value": ""
              }
            ],
            "mcp": {
              "tool": "git_commit",
              "description": "Commit the staged changes."
            },
            "body": {
              "content": [
                {
                  "type": "text",
                  "text": "Error: Aborting commit due to empty commit message."
                }
              ]
            }
          }
        ]
      }
    ]
  }
}
