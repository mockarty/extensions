    "connectors": [
      {
        "key": "gitlab_devtest",
        "name": "GitLab (dev/test contour)",
        "kind": "gitlab",
        "description": "Points Mockarty at this mocked contour, so a team can wire the integration before it has access to the real GitLab.",
        "icon": "code-bracket-square",
        "docs_url": "https://mockarty.ru/docs/integrations",
        "config_template": {
          "base_url": "https://gitlab.example.com",
          "project": "platform/payments-api"
        }
      }
    ],
    "content_packs": [
      {
        "key": "gitlab_contract_cases",
        "name": "GitLab integration checks",
        "kind": "tcm",
        "description": "The checks that tell you an integration handles GitLab's awkward paths, not just its happy one.",
        "items": [
          {
            "name": "Pagination is followed to the last page",
            "priority": "high",
            "tags": [
              "gitlab",
              "pagination"
            ],
            "expectedResult": "The client collects both pages and stops when the next link is absent.",
            "steps": [
              {
                "action": "Request page 1 of projects",
                "expectedResult": "One project and a Link header with rel=\"next\"."
              },
              {
                "action": "Follow the next link",
                "expectedResult": "The second project and NO next link."
              }
            ]
          },
          {
            "name": "A 429 is retried after Retry-After",
            "priority": "high",
            "tags": [
              "gitlab",
              "rate-limit"
            ],
            "expectedResult": "The client waits the advertised seconds instead of retrying immediately.",
            "steps": [
              {
                "action": "Call the rate-limited endpoint",
                "expectedResult": "429 with Retry-After: 30."
              },
              {
                "action": "Observe the client",
                "expectedResult": "It waits before the next attempt."
              }
            ]
          },
          {
            "name": "A conflicted merge request is never merged",
            "priority": "high",
            "tags": [
              "gitlab",
              "merge-requests"
            ],
            "expectedResult": "The job stops with a clear message instead of forcing the merge.",
            "steps": [
              {
                "action": "Read merge request 18",
                "expectedResult": "has_conflicts is true."
              },
              {
                "action": "Attempt the merge",
                "expectedResult": "405, and the job reports the conflict."
              }
            ]
          },
          {
            "name": "A failed pipeline blocks the release",
            "priority": "high",
            "tags": [
              "gitlab",
              "pipelines"
            ],
            "expectedResult": "The gate refuses to promote a build whose pipeline failed.",
            "steps": [
              {
                "action": "Read pipeline 901",
                "expectedResult": "status is failed and the gate stops."
              }
            ]
          },
          {
            "name": "A 500 with a slow response does not hang the client",
            "priority": "medium",
            "tags": [
              "gitlab",
              "errors"
            ],
            "expectedResult": "The client times out and reports the endpoint, not a generic failure.",
            "steps": [
              {
                "action": "Call the failing endpoint",
                "expectedResult": "The client gives up within its own timeout."
              }
            ]
          }
        ]
      }
    ],
