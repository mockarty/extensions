{
  "id": "mockarty.gitlab-dev-test-kit",
  "name": "GitLab dev/test kit",
  "version": "1.0.0",
  "description": "A GitLab API v4 contour you can develop and test against without a GitLab: projects, branches, commits, merge requests with approvals and conflicts, pipelines with jobs and logs, issues, the registry — plus the pagination, rate limits and error codes real integrations trip over.",
  "author": {
    "name": "Mockarty",
    "url": "https://mockarty.ru"
  },
  "homepage": "https://mockarty.ru/docs/plugins",
  "license": "MIT",
  "min_mockarty_version": "1.0.0",
  "settings_schema": {
    "type": "object",
    "properties": {
      "gitlab_base_url": {
        "type": "string",
        "title": "GitLab base URL",
        "description": "The GitLab this contour stands in for. Used by the connector preset and the deep links.",
        "default": "https://gitlab.example.com"
      },
      "api_token": {
        "type": "string",
        "format": "mockarty-secret-ref",
        "title": "GitLab token",
        "description": "Reference to the secret holding a GitLab token, for when you point the connector at a real instance."
      }
    }
  },
